# Default development listener is loopback. Secrets stay on the server.
PROJECTS_DATA_DIR=.projects
PROJECTS_DATABASE_URL=postgresql+psycopg://projects:projects@127.0.0.1:5432/projects
# Optional YAML path; default is projects.local.yaml in the working directory.
# PROJECTS_CONFIG=projects.local.yaml
# Environment LLM settings override YAML when present.
# PROJECTS_LLM_PROVIDER=codex_login
# PROJECTS_LLM_BASE_URL=https://api.openai.com/v1
# PROJECTS_LLM_MODEL=
# PROJECTS_LLM_API_KEY=
PROJECTS_SECURE_COOKIES=false
